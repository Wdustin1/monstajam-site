generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Track {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique
  number        Int
  title         String
  subtitle      String?
  artist        String
  genre         String
  bpm           Int?
  mood          String?
  color         String
  accentCyan    Boolean  @default(false)
  story         String?
  spotifyUrl    String?
  appleMusicUrl String?
  audioUrl      String?
  coverUrl      String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credits Credit[]

  @@map("tracks")
}

model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  artist      String?
  youtubeUrl  String
  youtubeId   String   // extracted video ID for embed/thumbnail
  duration    String?  // e.g. "3:52"
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

model Credit {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  role    String
  name    String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String @db.ObjectId

  @@map("credits")
}

enum VoteCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CreditAction {
  VOTE
  COMMENT
  SHARE
  JOIN
  SUPPORT
  ADMIN_ADJUSTMENT
}


model FanProfile {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  visitorId      String         @unique
  displayName    String?
  email          String?
  socialUrl      String?
  creditsBalance Int           @default(0)
  joinedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  votes        Vote[]
  creditLedger CreditLedger[]

  @@map("fan_profiles")
}

model VoteCampaign {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  slug        String             @unique
  title       String
  question    String
  description String?
  status      VoteCampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  options VoteOption[]
  votes   Vote[]

  @@map("vote_campaigns")
}

model VoteOption {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  campaign    VoteCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String       @db.ObjectId
  label       String
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  votes Vote[]

  @@unique([campaignId, label])
  @@map("vote_options")
}

model Vote {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  campaign     VoteCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String       @db.ObjectId
  option       VoteOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId     String       @db.ObjectId
  fanProfile   FanProfile?  @relation(fields: [fanProfileId], references: [id], onDelete: SetNull)
  fanProfileId String?      @db.ObjectId
  visitorId    String
  creditsSpent Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([campaignId, visitorId])
  @@index([optionId])
  @@index([visitorId])
  @@map("votes")
}

model CreditLedger {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  fanProfile   FanProfile?  @relation(fields: [fanProfileId], references: [id], onDelete: SetNull)
  fanProfileId String?      @db.ObjectId
  visitorId    String
  action       CreditAction
  amount       Int
  reason       String
  createdAt    DateTime     @default(now())

  @@index([visitorId])
  @@map("credit_ledger")
}

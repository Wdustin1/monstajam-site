{
  "name": "monstajam-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "test:admin-smoke": "tsx scripts/admin-smoke.ts",
    "test:draft-privacy": "tsx --test scripts/tests/draft-privacy.test.ts",
    "test:draft-privacy:integration": "node scripts/tests/draft-privacy.integration.cjs",
    "test:cover-proxy": "tsx --test scripts/tests/cover-proxy.test.ts",
    "test:admin-save": "tsx --test scripts/tests/admin-save.test.ts",
    "test:admin-save:fixture": "node scripts/tests/admin-save.fixture.cjs",
    "test:admin-editor": "tsx --test scripts/tests/admin-editor.test.cjs",
    "test:admin-accounts": "tsx --test scripts/tests/admin-accounts.test.ts scripts/tests/admin-accounts-ui.test.cjs",
    "test:admin-accounts:integration": "node scripts/tests/named-auth.integration.cjs",
    "test:admin-accounts:mongo": "tsx scripts/tests/admin-accounts.mongo.integration.ts --isolated-database",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:recover-owner": "tsx scripts/recover-admin-owner.ts",
    "test:audio": "tsx --test scripts/tests/*audio*.test.ts scripts/tests/*audio*.test.cjs scripts/tests/track-playback.test.ts scripts/tests/player-playback.test.cjs",
    "migrate:audio": "tsx scripts/migrate-audio.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.99.3",
    "@types/pg": "^8.18.0",
    "@vercel/blob": "^2.3.3",
    "better-auth": "1.7.7",
    "ffmpeg-static": "5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.1.1",
    "next": "16.3.8",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
